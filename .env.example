# --- Required ---
# Only this Google account (comma-separate for more) can sign in.
ALLOWED_EMAIL=you@gmail.com
# Google Cloud OAuth "Web application" client. Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback  and  https://<your-domain>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 48
SESSION_SECRET=
# openssl rand -base64 32   (encrypts your Google refresh token at rest)
TOKEN_ENC_KEY=
# Vercel AI Gateway key (Claude reads emails that have no flight markup). On Vercel, OIDC is used automatically.
AI_GATEWAY_API_KEY=
# Vercel Cron sends this as a bearer token to /api/cron/sync.
CRON_SECRET=

# --- Database ---
# Neon Postgres URL in production. Leave unset locally to use the embedded database in ./.data/pglite
# DATABASE_URL=

# --- Optional ---
# EXTRACTION_MODEL=anthropic/claude-haiku-5-5
# Local preview with sample flights (never enable in production)
# DEMO_MODE=1
